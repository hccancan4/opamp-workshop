# ─── Analytics ────────────────────────────────────────────────
# Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX)
# Only active in production builds (import.meta.env.PROD)
VITE_GA_MEASUREMENT_ID=

# ─── Contact form ─────────────────────────────────────────────
# Formspree form ID (sign up at https://formspree.io, create a form, copy the ID)
# Form URL will be: https://formspree.io/f/<VITE_FORMSPREE_ID>
VITE_FORMSPREE_ID=

# ─── Ko-fi ────────────────────────────────────────────────────
# Your Ko-fi page URL (e.g. https://ko-fi.com/yourusername)
VITE_KOFI_URL=https://ko-fi.com

# ─── Site URL ─────────────────────────────────────────────────
# Used for canonical URLs and OG tags. No trailing slash.
# Set this to your actual Vercel deployment URL.
VITE_SITE_URL=https://opamp-atolyesi.vercel.app
